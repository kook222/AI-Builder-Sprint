{
  "manifest_version": 3,
  "name": "공식 사이트 판별기",
  "version": "0.1.0",
  "description": "Google 검색 결과에 공식/공신력 사이트 딱지를 표시합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "공식 사이트 딱지"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.kr/search*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "badge.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
